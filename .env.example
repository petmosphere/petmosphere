# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development

# Supabase Auth (public browser configuration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web Push (public key in the browser; private key and cron secret are server-only)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:info.petmosphere@gmail.com
CRON_SECRET=

# AI provider (future server-side use)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Email (future use)
RESEND_API_KEY=

# Payments (future use)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Monitoring (optional; the DSN is a public project identifier, not a secret)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Secret build credential for uploading source maps; never prefix with NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=
